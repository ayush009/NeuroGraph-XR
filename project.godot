; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NeuroGraph_XR"
run/main_scene="res://ds_main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/generated/neurograph_logo.png"

[audio]

general/text_to_speech=true
driver/enable_input=true

[display]

window/size/mode=2

[dotnet]

project/assembly_name="NeuroGraphXR"

[editor_plugins]

enabled=PackedStringArray()

[physics]

3d/physics_engine="Jolt Physics"

[plugins]

claude_api/api_key=""

[renderer]

rendering_method.mobile="mobile"

[rendering]

textures/vram_compression/import_etc2_astc=true
camera/depth_of_field/depth_of_field_bokeh_quality=0
anti_aliasing/quality/msaa_3d=2.0
textures/limit/texture_size_limit_3d=2048.0
textures/limit/texture_size_limit_2d=1024.0

[shader_globals]

section_enabled={
"type": "bool",
"value": false
}
section_plane={
"type": "vec4",
"value": Vector4(0, 1, 0, 1000)
}
section_cap_color={
"type": "color",
"value": Color(0.9, 0.15, 0.2, 1)
}

[xr]

openxr/enabled=true
openxr/reference_space=2.0
openxr/foveation_level="1"
openxr/foveation_dynamic=true
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
shaders/enabled=true
openxr/extensions/htc/passthrough=true
